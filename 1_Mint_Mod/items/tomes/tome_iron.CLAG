Firearm
$AUTHOR: JCzypie

$ID: mint_tome_iron
$NAME: Iron Spelltome
$DESCRIPTION1: Shoots Bursts of Magic that destroy blocks
$DESCRIPTION2: Requires Mana Orbs

$"MODEL: gemtome
"ANIMATION: Generic
*MODEL_COLOR1: Iron
*MODEL_COLOR2: 255, 255, 255

=HIDE_CROSSHAIR: True

$AMMO_NAME: mint_orb
"PROJECTILE_TYPE: Laser
%BULLET_SPEED: 85
%BULLET_LIFETIME: .12
*PROJECTILE_COLOR: Iron

=AUTOMATIC: True
#CLIP_SIZE: 5
#ROUNDS_PER_RELOAD: 5
%SECONDS_TO_RELOAD: 0.5
%BULLETS_PER_SECOND: 45
"RELOAD_SFX: ShotGunReload
"SHOOT_SFX: LightSaberSwing

%DAMAGE: 50
%SELF_DAMAGE: .1
%RECOIL: 0
%INACCURACY: 2

%ICON_SIZE: .66
ICON_POSITION: 0, 0, 0